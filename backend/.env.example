# Copy to .env (Windows: copy .env.example .env) and fill in. Never commit .env.
PORT=4000
# Where the front end runs. Comma-separate several (e.g. localhost and the deployed site);
# the first one is where Stripe sends drivers back after paying.
FRONTEND_URL=http://localhost:3000

# Optional. Leave empty to use the built-in database (saved in backend/.data).
# Or a Postgres connection string (e.g. for deploying).
DATABASE_URL=
# Signs sign-in tokens. Any long random string (change it if you deploy).
AUTH_SECRET=

# Stripe sandbox keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Local: printed by `npm run stripe:listen`. Deployed: from the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Printed by `npm run stripe:demo-host`; the seeded chargers pay out to this sandbox account
STRIPE_DEMO_ACCOUNT_ID=

# OpenRouter: openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Second model for the bill-reading comparison (check the exact id at openrouter.ai/anthropic)
OPENROUTER_COMPARE_MODEL=anthropic/claude-sonnet-4.5

# Simulated charger clock speed (60 = one real minute is one charging hour)
DEMO_SPEEDUP=60
