# Copy to .env. Leave STRIPE_SECRET_KEY empty to run in mock-payments mode.
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Stripe sandbox (test mode) keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Printed by `npm run stripe:listen`
STRIPE_WEBHOOK_SECRET=

# OpenRouter: openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Simulated charger clock speed (60 = one real minute is one charging hour)
DEMO_SPEEDUP=60
