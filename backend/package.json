{
  "name": "kerb-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.expired,payment_intent.payment_failed,payment_intent.canceled,identity.verification_session.verified,identity.verification_session.requires_input,identity.verification_session.processing,identity.verification_session.canceled,account.updated --forward-to localhost:4000/api/webhooks/stripe",
    "stripe:demo-host": "tsx scripts/demo-host.ts",
    "ai:compare": "tsx scripts/compare-models.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5",
    "tsx": "^4.23.15",
    "@electric-sql/pglite": "^0.5.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
